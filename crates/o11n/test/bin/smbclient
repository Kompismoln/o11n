#!/usr/bin/env bash
# Fact: the share holds a directory for each name in SMB_DIRS, and refuses any password but SMB_PASSWORD.
args=("$@") auth='' command=''
for ((i = 0; i < $#; i++)); do
	[[ ${args[i]} != -A ]] || auth=${args[i + 1]}
	[[ ${args[i]} != -c ]] || command=${args[i + 1]}
done
{
	printf 'smbclient'
	printf ' %s' "$@"
	echo
	cat "$auth"
} >>"$BATS_TEST_TMPDIR/smbclient"
[[ $(sed -n 's/^password = //p' "$auth") == "${SMB_PASSWORD:-}" ]] || {
	echo 'session setup failed: NT_STATUS_LOGON_FAILURE'
	exit 1
}
case $command in
ls) exit ;;
cd\ *)
	dir=${command#cd }
	dir=${dir//\"/}
	[[ " ${SMB_DIRS:-} " == *" $dir "* ]] || {
		printf 'cd \\%s\\: NT_STATUS_OBJECT_NAME_NOT_FOUND\n' "$dir"
		exit 1
	}
	;;
esac
