#!/usr/bin/env bash
known_hosts='' no_command=''
while [[ $1 == -* ]]; do
	case $1 in
	-t | -n | -f) shift ;;
	-N)
		no_command=1
		shift
		;;
	-o)
		[[ $2 == UserKnownHostsFile=* ]] && known_hosts=${2#*=}
		shift 2
		;;
	*) shift 2 ;;
	esac
done
IFS='@' read -r name fqdn <<<"$1"
IFS='.' read -r host _ <<<"$fqdn"

hostkey=$BATS_TEST_TMPDIR/host-$fqdn/keys/ssh-key
if [[ -n $known_hosts && -f $hostkey ]] &&
	! grep -qF "$(ssh-keygen -y -f "$hostkey" | cut -d' ' -f1,2)" "$known_hosts"; then
	echo "Host key verification failed." >&2
	exit 255
fi
[[ -z $no_command ]] || exit 0

case "$name" in
locksmith)
	export LUKS_DEVICE="/dev/null"
	export KEY_FILE=$BATS_TEST_TMPDIR/host-$fqdn/keys/host-$host
	export SYSTEM_PROFILE=$BATS_TEST_TMPDIR/host-$fqdn/system
	export CURRENT_SYSTEM=$BATS_TEST_TMPDIR/host-$fqdn/current
	export BOOT_LOADER=${BOOT_LOADER:-grub}
	export BOOT_DIR=$BATS_TEST_TMPDIR/host-$fqdn/boot
	export INITRD_KEY_FILE=./.initrd-secrets/luks-key
	shift
	"$LOCKSMITH" "$@"
	;;
root)
	shift
	ssh-add -l >/dev/null || exit 255
	case $1 in
	du) echo "1536	$4" ;;
	tar)
		if [[ $2 == --zstd && $3 == -x ]]; then
			cat >"$BATS_TEST_TMPDIR/extracted-$fqdn"
		else
			echo "the tar of $* on $fqdn"
		fi
		;;
	find) cat "$BATS_TEST_TMPDIR/home-$fqdn" 2>/dev/null || true ;;
	"set -o pipefail;")
		shift
		IFS= read -r password
		if [[ " $* " == *" snapshots --json "* ]]; then
			cat "$BATS_TEST_TMPDIR/snapshots-$fqdn" 2>/dev/null || echo '[]'
		else
			echo "$* on $fqdn, with $password"
		fi
		;;
	systemctl) cat "$BATS_TEST_TMPDIR/trigger-$fqdn" 2>/dev/null || echo ;;
	esac
	;;
nix-switch)
	case $2 in
	status) cat "$BATS_TEST_TMPDIR/deployed-$fqdn" ;;
	allotments) cat "$BATS_TEST_TMPDIR/allotments-$fqdn" 2>/dev/null || true ;;
	esac
	;;
logs)
	ssh-add -l >/dev/null && echo "the logs of $fqdn since $2"
	;;
testadmin | admin)
	shift
	ssh-add -l >/dev/null && echo "$name@$fqdn $*"
	;;
*)
	echo "invalid user '$name'" >&2
	exit 1
	;;
esac
